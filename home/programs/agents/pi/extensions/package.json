{
  "name": "personal-pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/format.ts src/rtk.ts --bundle --platform=node --format=esm --target=node24 --external:@earendil-works/* --outdir=dist",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "pi": {
    "extensions": ["./src/format.ts", "./src/rtk.ts"]
  },
  "dependencies": {
    "effect": "3.22.4",
    "smol-toml": "1.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
